# The backup scripts run on the hermes Linux host but are edited on Windows.
# A CRLF line ending would make the shebang fail there with the unhelpful
# "/usr/bin/env: bash\r: No such file or directory", so pin them to LF
# regardless of anyone's core.autocrlf setting.
*.sh text eol=lf
scripts/backup/*.mjs text eol=lf
